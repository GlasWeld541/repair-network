NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Mapbox token used to geocode a customer's location for the provider picker + claim routing.
MAPBOX_TOKEN=your_mapbox_token

# Rex-repair scoring (customer job before/after → Rex's engine). Both must match the Rex
# backend's SCORE_REPAIR_SHARED_SECRET; scoring stays inert (fails closed) until set.
REX_BACKEND_URL=https://backend-production-ad25.up.railway.app
SCORE_REPAIR_SHARED_SECRET=shared_secret_matching_the_rex_backend

# Payment processor (Braintree). The charge cron reports "no processor configured" and charges
# nothing unless PAYMENT_PROCESSOR_ENABLED=true AND a provider is set AND its credentials exist.
# BRAINTREE_ENVIRONMENT defaults to sandbox, so production is always an explicit opt-in.
# Never commit real values — these belong in the Vercel project's env vars.
PAYMENT_PROCESSOR_ENABLED=false
PAYMENT_PROCESSOR_PROVIDER=braintree
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
